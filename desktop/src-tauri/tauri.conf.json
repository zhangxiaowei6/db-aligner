{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBAligner",
  "version": "0.1.1",
  "identifier": "io.dbaligner.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["../build/icon.ico"],
    "resources": {
      "../../.tools/runtime/": "runtime",
      "../../engine/target/engine.jar": "engine/engine.jar",
      "../../engine/target/lib/": "engine/lib",
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../licenses/": "licenses"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4REE4Q0JBMjQyRjUyMDcKUldRSFVpOGt1b3phbUxrRStpUWZWZnB5dUwwY2lWWHZQbzRsaVJYcjhFVVBJdFp5YjVSWGxjMlQK",
      "endpoints": [
        "https://github.com/zhangxiaowei6/db-aligner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
