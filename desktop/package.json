{
  "name": "db-aligner-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "powershell -ExecutionPolicy Bypass -File ../scripts/tauri.ps1 dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=15000",
    "qa:ui": "node scripts/ui-qa.mjs",
    "qa:tree": "node scripts/tree-qa.mjs",
    "qa:desktop": "node scripts/native-qa.mjs",
    "dist": "powershell -ExecutionPolicy Bypass -File ../scripts/tauri.ps1 build",
    "dist:unsigned": "powershell -ExecutionPolicy Bypass -File ../scripts/tauri.ps1 build-unsigned"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tauri-apps/api": "2.12.2",
    "antd": "6.6.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "^0.25.12",
    "jsdom": "^27.0.0",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "description": "DBAligner desktop tool for auditable MySQL and PostgreSQL schema and reference data alignment",
  "author": "DBAligner contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangxiaowei6/db-aligner.git"
  },
  "homepage": "https://github.com/zhangxiaowei6/db-aligner",
  "bugs": {
    "url": "https://github.com/zhangxiaowei6/db-aligner/issues"
  }
}
