{
  "name": "db-aligner-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build:electron && node scripts/dev.mjs",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --external:electron-updater --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/preload.cjs",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --testTimeout=15000",
    "qa:ui": "node scripts/ui-qa.mjs",
    "qa:tree": "node scripts/tree-qa.mjs",
    "qa:desktop": "node scripts/ui-qa.mjs --desktop",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.5",
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "jsdom": "^27.0.0",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "io.dbaligner.desktop",
    "productName": "DBAligner",
    "directories": {
      "output": "../release"
    },
    "electronDist": "../node_modules/electron/dist",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "../engine/target/engine.jar",
        "to": "engine/engine.jar"
      },
      {
        "from": "../engine/target/lib",
        "to": "engine/lib"
      },
      {
        "from": "../.tools/runtime",
        "to": "runtime"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../licenses",
        "to": "licenses"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "license": "../LICENSE"
    },
    "publish": {
      "provider": "github",
      "owner": "zhangxiaowei6",
      "repo": "db-aligner",
      "releaseType": "draft"
    }
  },
  "description": "DBAligner desktop tool for auditable MySQL schema and reference data alignment",
  "author": "DBAligner contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangxiaowei6/db-aligner.git"
  },
  "homepage": "https://github.com/zhangxiaowei6/db-aligner",
  "bugs": {
    "url": "https://github.com/zhangxiaowei6/db-aligner/issues"
  }
}
